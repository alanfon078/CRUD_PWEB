@model CRUD_PWEB.Models.Product
@{
    ViewData["Title"] = "Detalles del Producto";
}
<h1>Detalles del Producto</h1>
<div>
    <h4>Ficha Técnica</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProductName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProductName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UnitPrice)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UnitPrice)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QuantityPerUnit)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.QuantityPerUnit)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class="col-sm-10">
            <!-- Muestra el Nombre de la Categoría en lugar del ID -->
            @Html.DisplayFor(model => model.Category.CategoryName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Supplier)
        </dt>
        <dd class="col-sm-10">
            <!-- Muestra el Nombre del Proveedor en lugar del ID -->
            @Html.DisplayFor(model => model.Supplier.CompanyName)
        </dd>
    </dl>
</div>
<div>
    <div>
        <a class="btn btn-success btn-sm" asp-action="Edit" asp-route-id="@Model?.ProductId">Editar</a> |
        <a class="btn btn-secondary btn-sm" asp-action="Index">Volver a la lista</a>
    </div>